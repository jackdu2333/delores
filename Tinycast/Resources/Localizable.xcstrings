      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Delores"
          }
        }
      }
    },
    "Access Delores needs to work with other apps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Delores 与其他应用配合时需要这些访问权限。"
