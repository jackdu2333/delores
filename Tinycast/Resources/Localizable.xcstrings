    "Accessibility permission required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限"
          }
        }
      }
    },
    "Act on the text you have selected in any app. Delores reads a selection only after a shortcut or a completed selection gesture, then shows the Context Island.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对任意应用中选中的文本执行操作。Delores 只在快捷键或划词手势完成后读取选区，然后显示上下文岛。"
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作"
