    "Behaviour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行为"
          }
        }
      }
    },
    "Both read and move other apps' windows through the same Accessibility permission Delores uses to paste. Neither is enabled by default, and neither is restored from a settings backup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这两项都通过 Delores 粘贴时使用的同一辅助功能权限，读取并移动其他应用的窗口。默认关闭，也不会从设置备份中恢复。"
          }
        }
      }
    },
    "Bring the menu bar back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复顶部状态栏"
          }
